ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
IMAGE_PROVIDER=cloudflare
IMAGE_GENERATION_CONCURRENCY=4
IMAGE_ENABLE_REWRITE_RECOVERY=false
CLOUDFLARE_MAX_RETRIES=4
CLOUDFLARE_BACKOFF_BASE_SECONDS=1.0

YOUTUBE_PROXY_ENABLED=true
YOUTUBE_PROXY_HTTP_URL="youtube proxy url"
YOUTUBE_PROXY_HTTPS_URL="youtube proxy url"

# DISABLE, Nunchaku is currently unavilable. Set IMAGE_PROVIDER=nunchaku to use it.
NUNCHAKU_API_KEY=sk-nunchaku-...
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
NUNCHAKU_MIN_INTERVAL_SECONDS=2.0
NUNCHAKU_MAX_429_RETRIES=4
NUNCHAKU_BACKOFF_BASE_SECONDS=3.0
